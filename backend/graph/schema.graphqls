type Query {
  trips: [Trip!]!
  trip(id: ID!): Trip
  agentRun(id: ID!): AgentRun
  tripsBySession(sessionId: String!): [Trip!]!
  tripUsage(tripId: ID!): [UsageSnapshot!]!
}

type Mutation {
  analyzeTrip(input: TripInput!): TripAnalysis!
  confirmTrip(input: ConfirmTripInput!): Trip!
  submitUsageSnapshot(input: SubmitUsageSnapshotInput!): UsageSnapshot!
}

input TripInput {
  destination: String!
  startDate: String!
  endDate: String!
  travelerType: TravelerType!
  budgetUsd: Float
  usage: UsageInput!
  sessionId: String
}

input UsageInput {
  streaming: UsageLevel!
  videoCalls: UsageLevel!
  hotspot: UsageLevel!
  maps: UsageLevel!
  socialMedia: UsageLevel!
  work: UsageLevel!
}

input ConfirmedPlanInput {
  provider: String!
  name: String!
  priceUsd: Float!
  dataLabel: String!
  validityDays: Int!
}

# Confirms a trip was actually purchased (web checkout or SailGuard).
# Pass tripId to confirm a trip that analyzeTrip already created.
# Omit tripId (and supply destination/startDate/endDate instead) when the
# purchase originates somewhere with no existing Connecta trip row yet —
# this creates the trip and marks it confirmed in one step, which is the
# path SailGuard uses since it doesn't call analyzeTrip itself.
input ConfirmTripInput {
  tripId: ID
  sessionId: String
  destination: String
  startDate: String
  endDate: String
  travelerType: TravelerType
  plan: ConfirmedPlanInput!
}

input SubmitUsageSnapshotInput {
  tripId: ID!
  dataUsedMb: Float!
  batteryPct: Int
  networkType: String
}

enum TravelerType {
  SOLO
  COUPLE
  FAMILY
  BUSINESS
}

enum UsageLevel {
  NONE
  LIGHT
  MODERATE
  HEAVY
}

type Trip {
  id: ID!
  destination: String!
  startDate: String!
  endDate: String!
  travelerType: TravelerType!
  estimatedGb: Float
  recommendedGb: Float
  selectedPlan: PlanOption
  confirmedAt: String
  confirmedPlan: ConfirmedPlan
}

type ConfirmedPlan {
  provider: String!
  name: String!
  priceUsd: Float!
  dataLabel: String!
  validityDays: Int!
}

type UsageSnapshot {
  id: ID!
  tripId: ID!
  dataUsedMb: Float!
  batteryPct: Int
  networkType: String
  capturedAt: String!
}

type TripAnalysis {
  tripId: ID!
  agentRunId: ID!
  estimatedGb: Float!
  recommendedGb: Float!
  confidence: Float!
  usageBreakdown: UsageBreakdown!
  selectedPlan: PlanOption!
  recommendation: String!
  alternatives: [PlanOption!]!
  connectivityGuide: ConnectivityGuide
  agentSteps: [AgentStep!]!
}

type UsageBreakdown {
  maps: Float!
  streaming: Float!
  socialMedia: Float!
  videoCalls: Float!
  hotspot: Float!
  work: Float!
}

type PlanOption {
  id: ID!
  provider: String!
  name: String!
  priceUsd: Float!
  dataGb: Float!
  validityDays: Int!
  tradeoff: String!
}

type ConnectivityGuide {
  beforeDeparture: [String!]!
  airportSetup: [String!]!
  offlineStrategy: [String!]!
  backupInternet: [String!]!
  emergencyAccess: [String!]!
}

type AgentRun {
  id: ID!
  tripId: ID
  status: AgentStatus!
  steps: [AgentStep!]!
}

type AgentStep {
  name: String!
  status: AgentStatus!
  durationMs: Int!
  inputSummary: String
  outputSummary: String
  retries: Int!
  error: String
}

enum AgentStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
  SKIPPED
}
